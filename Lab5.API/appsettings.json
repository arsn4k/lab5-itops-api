{
  "ConnectionStrings": {
    "Lab5Database": "Data Source=lab5.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Hosting": {
    "UseHttpsRedirection": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
