{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lab5.API (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Lab5.API/bin/Debug/net8.0/Lab5.API.dll",
      "cwd": "${workspaceFolder}/Lab5.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7080;http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
